# ==============================================================================
# SMARTATTEND - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit real credentials, tokens, or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Face Recognition Python Microservice
# ------------------------------------------------------------------------------
FACE_SERVICE_URL=http://localhost:8001
FACE_SERVICE_API_KEY=smartattend_face_service_dev_key_secret
FACE_CONFIDENCE_THRESHOLD=0.60
FACE_LIVENESS_ENABLED=true

# ------------------------------------------------------------------------------
# Biometric Device Bridge (Fingerprint Hardware)
# ------------------------------------------------------------------------------
DEVICE_BRIDGE_PORT=8002
DEVICE_BRIDGE_API_KEY=smartattend_device_bridge_key_secret
DEVICE_BRIDGE_MODE=simulator # 'simulator' or 'hardware'

# ------------------------------------------------------------------------------
# Meta WhatsApp Business Platform Cloud API
# ------------------------------------------------------------------------------
# Obtain from https://developers.facebook.com/apps/
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=100654321098765
WHATSAPP_BUSINESS_ACCOUNT_ID=200987654321098
WHATSAPP_ACCESS_TOKEN=EAA...
WHATSAPP_VERIFY_TOKEN=smartattend_meta_webhook_verify_token_secure
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# ------------------------------------------------------------------------------
# Application School Profile Defaults (Asia/Kolkata timezone)
# ------------------------------------------------------------------------------
SCHOOL_TIMEZONE=Asia/Kolkata
SCHOOL_DEFAULT_OPENING_TIME=08:30
SCHOOL_DEFAULT_GRACE_PERIOD_MINUTES=15
SCHOOL_DEFAULT_CUTOFF_TIME=10:00
